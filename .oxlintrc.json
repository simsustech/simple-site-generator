{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "caughtErrors": "none"
      }
    ],
    "@typescript-eslint/no-explicit-any": "off"
  }
}

/node_modules
/packages/**/node_modules
/packages/**/dist
/packages/**/components.d.ts
/.npmrc
/.pnpm-store

# Test-runner artifacts. Vitest writes a JSON reporter output under .vitest/,
# which is not source and otherwise surfaces as an unformatted untracked file
# that `format:check` fails on.
/packages/**/.vitest
/.vitest

# Lighthouse reports produced by `ssg verify`.
/.lighthouseci

# Playwright artifacts from `pnpm run test:e2e`.
/test-results
/playwright-report

# Working notes, not source. The research and design analyses that inform the
# template rewrite; kept out of the repo so they do not ship as documentation.
/linear-design-analysis.md
/startup-website-findings.md
/rewrite.md

# The coding agent's own cache (`fff` frecency, debug logs). Machine-local state,
# never source, and it reappears after every session.
/.pi

/node_modules
/packages/**/node_modules
/packages/**/dist
/packages/**/components.d.ts
/.npmrc
/.pnpm-store

# Test-runner artifacts. Vitest writes a JSON reporter output under .vitest/,
# which is not source and otherwise surfaces as an unformatted untracked file
# that `format:check` fails on.
/packages/**/.vitest
/.vitest

# Lighthouse reports produced by `ssg verify`.
/.lighthouseci

# Playwright artifacts from `pnpm run test:e2e`.
/test-results
/playwright-report

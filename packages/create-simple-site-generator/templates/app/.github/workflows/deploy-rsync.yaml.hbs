name: Build and deploy through rsync

on:
  push:
    branches: ["production"]

env:
  working-directory: ./
  url: {{ url }}

jobs:
  build:
    name: Build and deploy production
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Creating .npmrc
        run: |
          cat > $\{{env.working-directory}}.npmrc << EOF
            @simsustech:registry=https://npm.simsus.tech
            //npm.simsus.tech/:_authToken=$SIMSUSTECH_NPM_TOKEN
          EOF
        env:
          SIMSUSTECH_NPM_TOKEN: $\{{ secrets.SIMSUSTECH_NPM_TOKEN }}

      - name: Install pnpm
        # generated projects have no packageManager field, so set the version here
        uses: pnpm/action-setup@v6
        with:
          version: 12

      - name: Use Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24

      - name: Install and build
        working-directory: $\{{ env.working-directory }}
        run: |
          pnpm i
          pnpm run build

      - name: rsync deployments
        uses: burnett01/rsync-deployments@v9
        with:
          switches: -avzr --delete
          path: $\{{env.working-directory}}dist/static/
          remote_path: /srv/$\{{env.url}}
          remote_host: $\{{ secrets.DEPLOY_HOST }}
          remote_user: $\{{ secrets.DEPLOY_USER }}
          remote_key: $\{{ secrets.DEPLOY_KEY }}

      - name: Remove .npmrc
        # run even if an earlier step failed: this file holds registry tokens
        if: always()
        # -f: the file may legitimately be gone already
        run: rm -f $\{{env.working-directory}}.npmrc

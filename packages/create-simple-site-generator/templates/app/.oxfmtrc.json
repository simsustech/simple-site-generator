{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 80,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.hbs",
    ".github/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "overrides": [
    {
      "files": ["*.json5"],
      "options": {
        "singleQuote": false,
        "quoteProps": "preserve"
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}

{
  "name": "@simple-site-generator/templates",
  "version": "0.1.19",
  "author": "simsustech",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/emit-types.mjs",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./landing": {
      "types": "./dist/landing.d.ts",
      "import": "./dist/landing.js"
    },
    "./business": {
      "types": "./dist/business.d.ts",
      "import": "./dist/business.js"
    },
    "./design": {
      "types": "./dist/design.d.ts",
      "import": "./dist/design.js"
    },
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "seo": [
        "./dist/seo.d.ts"
      ],
      "docs": [
        "./dist/docs.d.ts"
      ],
      "landing": [
        "./dist/landing.d.ts"
      ],
      "business": [
        "./dist/business.d.ts"
      ],
      "design": [
        "./dist/design.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@quasar/quasar-ui-qmediaplayer": "^3.0.1",
    "gray-matter": "^4.0.3",
    "import-meta-resolve": "^4.2.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/runtime-dom": "^3.5.42",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "quasar": "^2.32.3",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitrify": "^0.28.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simsustech/simple-site-generator.git",
    "directory": "packages/templates"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

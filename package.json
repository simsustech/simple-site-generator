{
  "name": "simple-site-generator-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "run-s build:cli build:templates",
    "build:cli": "cd packages/simple-site-generator && pnpm run build",
    "build:templates": "cd packages/templates && pnpm run build",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "version": "changeset version",
    "publish": "changeset publish",
    "lint": "oxlint packages/*/src/",
    "lint:fix": "oxlint --fix packages/*/src/",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:lighthouse": "vitest run tests/lighthouse",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "changesets": "^1.0.2",
    "chrome-launcher": "^1.2.2",
    "git-conventional-commits": "^2.9.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.5.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "quasar": "^2.35.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint && pnpm run format:check",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*": [
      "oxfmt --write"
    ],
    "packages/*/{src,types}/**/*.ts": [
      "oxlint"
    ],
    "packages/**/*.d.ts": [
      "oxlint"
    ]
  }
}
